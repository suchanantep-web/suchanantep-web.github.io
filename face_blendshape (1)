<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MindAR Blendshape</title>
  <script type="importmap">
    { "imports": {
      "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
      "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/",
      "mindar-face-three": "https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-face-three.prod.js"
    } }
  </script>
  <style>
    body { margin: 0; font-family: system-ui, sans-serif; background: #111; color: #fff; }
    #container { width: 100vw; height: 100vh; position: relative; overflow: hidden; }
    #start, #status {
      position: fixed;
      z-index: 10;
      left: 50%;
      transform: translateX(-50%);
    }
    #start { bottom: 24px; padding: 12px 20px; border: 0; border-radius: 6px; font: inherit; cursor: pointer; }
    #status { top: 16px; max-width: calc(100vw - 32px); padding: 10px 14px; background: #111c; text-align: center; }
    #status:empty { display: none; }
  </style>
</head>
<body>
  <div id="container"></div>
  <div id="status" role="status" aria-live="polite"></div>
  <button id="start" type="button">เริ่มกล้อง</button>
  <script type="module">
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
    import { MindARThree } from 'mindar-face-three';

    const status = document.querySelector('#status');
    const startButton = document.querySelector('#start');
    const mindar = new MindARThree({ container: document.querySelector('#container') });
    const { renderer, scene, camera } = mindar;
    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    const roomEnvironment = new RoomEnvironment();
    const environmentTarget = pmremGenerator.fromScene(roomEnvironment);
    scene.environment = environmentTarget.texture;
    roomEnvironment.dispose();
    pmremGenerator.dispose();
    scene.add(new THREE.HemisphereLight(0xffffff, 0xbbbbff, 1));
    const anchor = mindar.addAnchor(1);
    let started = false;

    startButton.addEventListener('click', async () => {
      if (started) return;
      startButton.disabled = true;
      status.textContent = 'กำลังโหลดโมเดล...';
      try {
        const gltf = await new GLTFLoader().loadAsync('./Untitled.glb');
        gltf.scene.scale.setScalar(2);
        anchor.group.add(gltf.scene);

        const meshes = [];
        gltf.scene.traverse(object => {
          if (object.isMesh && object.morphTargetDictionary && object.morphTargetInfluences) meshes.push(object);
        });
        if (meshes.length === 0) {
          status.textContent = 'โมเดลโหลดแล้ว แต่ไม่พบ Morph Targets สำหรับขยับใบหน้า';
        } else {
          status.textContent = 'กำลังเริ่มกล้อง...';
        }

        await mindar.start();
        started = true;
        startButton.hidden = true;
        if (meshes.length > 0) status.textContent = 'หันหน้าเข้ากล้อง';

        renderer.setAnimationLoop(() => {
          const categories = mindar.getLatestEstimate()?.blendshapes?.categories ?? [];
          for (const mesh of meshes) {
            for (const { categoryName, score } of categories) {
              const index = mesh.morphTargetDictionary[categoryName];
              if (index !== undefined) mesh.morphTargetInfluences[index] = score;
            }
          }
          renderer.render(scene, camera);
        });
      } catch (error) {
        console.error(error);
        status.textContent = `เริ่มใช้งานไม่สำเร็จ: ${error.message || error}`;
        startButton.disabled = false;
      }
    });
  </script>
</body>
</html>
